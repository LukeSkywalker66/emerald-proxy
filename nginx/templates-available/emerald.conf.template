# 0. SELECCIÓN DE PÁGINA DE MANTENIMIENTO (definida en contexto http)
map $emerald_maintenance $error_503_uri {
    default "/error-pages/503.html";
    "on" "/error-pages/maintenance.html";
}

# 1. EL REDIRECTOR GLOBAL (Manda todo a HTTPS)
server {
    listen 80;
    server_name ${DOMAIN};
    client_max_body_size 20m;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. EL SERVIDOR SEGURO (Agnóstico al entorno)
server {
    listen 443 ssl;
    server_name ${DOMAIN};
    client_max_body_size 20m;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $emerald_prod http://${UPSTREAM_CONTAINER};
    set $emerald_maintenance off;

    # Páginas de error personalizadas
    error_page 403 /error-pages/403.html;
    error_page 404 /error-pages/404.html;
    error_page 413 /error-pages/413.html;
    error_page 500 /error-pages/500.html;
    error_page 502 /error-pages/502.html;
    error_page 503 $error_503_uri;
    error_page 504 /error-pages/504.html;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        # Mantenimiento programado: si existe el flag, devolver 503
        if (-f /var/www/maintenance/on) {
            set $emerald_maintenance on;
            return 503;
        }

        proxy_pass $emerald_prod;
        proxy_intercept_errors on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Assets estáticos de las páginas de error (imágenes y CSS)
    location /error-pages/assets/ {
        root /var/www;
        access_log off;
        add_header Cache-Control "public, max-age=86400";
    }

    # Páginas de error (HTML), sin cache para reflejar el mantenimiento al instante
    location /error-pages/ {
        root /var/www;
        access_log off;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}
